    <string name="label_display">표시</string>
    <string name="switch_always_on_top_title">항상 위에 고정</string>
    <string name="switch_always_on_top_desc">ON이면 다른 앱을 열 때마다 펫이 자동으로 나타납니다. OFF면 ③ 버튼을 눌렀을 때만 표시됩니다.</string>
    <string name="switch_lock_title">위치 잠금(터치 통과)</string>
    <string name="switch_lock_desc">ON으로 하면 터치가 아래 앱으로 그대로 전달되고, 드래그로 이동할 수 없습니다.</string>
    <string name="btn_reset_pos">위치 초기화</string>

    <string name="label_builtin_color">내장 색상</string>
    <string name="desc_builtin_color">이미지 탭에서 이미지를 추가하지 않은 동안 여기서 선택한 색이 사용됩니다.</string>
    <string name="label_selected">선택됨</string>
    <string name="label_select">선택</string>

    <string name="btn_remove">삭제</string>


    <string name="label_icon_section">홈 화면 아이콘(선택)</string>
    <string name="desc_icon_section">Android 특성상 앱 자체의 아이콘은 설치 후에 바꿀 수 없습니다. 대신 선택한 이미지를 사용한 바로가기를 홈 화면에 추가할 수 있습니다. 추가한 뒤에는 그 아이콘으로 앱을 열어주세요.</string>
    <string name="btn_add_icon_shortcut">이미지를 선택해 홈 화면에 추가</string>
    <string name="toast_icon_not_supported">이 기기는 홈 화면 아이콘 추가를 지원하지 않습니다</string>

    <string name="label_idle">대기 이미지</string>
    <string name="btn_add_image">+ 이미지 추가(여러 장 선택 가능)</string>
    <string name="empty_hint">아직 이미지가 없습니다</string>
    <string name="desc_idle">입력하지 않을 때 표시됩니다. 여러 장이면 대기로 돌아올 때마다 랜덤으로 1장 선택됩니다. 비어 있으면 타이핑 중 1번째 이미지(없으면 내장 색상)를 사용합니다.</string>
    <string name="label_steps">타이핑 중 이미지(순서)</string>
    <string name="desc_steps">입력 중에는 1번째 → 2번째 → 3번째… 순서로 바뀌고, 끝까지 가면 1번째로 돌아갑니다. 같은 번호에 다른 패턴을 추가하면 그 번호일 때 랜덤으로 1장 선택됩니다.</string>
    <string name="step_label">%1$d번째</string>
    <string name="btn_add_variant">+ 다른 패턴 추가</string>
    <string name="btn_add_step">+ 다음 번호 추가</string>
    <string name="btn_delete_step">이 번호 삭제</string>
    <string name="label_triggers">문자로 전환(선택)</string>
    <string name="desc_triggers">등록한 문자를 입력하는 순간, 그 이미지 중 랜덤으로 1장 표시됩니다. 하나의 이미지에 여러 문자를 지정할 수 있습니다(예: 「아」「우」로 시무룩한 얼굴). 전각과 반각은 다른 문자로 취급합니다. 입력 내용은 저장·전송하지 않고, 입력한 위치 바로 앞 몇 글자에 등록 문자가 있는지만 그 자리에서 확인합니다.</string>
    <string name="trigger_keys_label">반응할 문자: %1$s</string>
    <string name="key_format">「%1$s」</string>
    <string name="btn_edit_keys">문자 편집</string>
    <string name="btn_add_trigger">+ 문자 반응 추가</string>
    <string name="dialog_keys_title">반응할 문자</string>
    <string name="dialog_keys_hint">예: 아 우 (공백으로 구분해 여러 개 가능)</string>
    <string name="btn_ok">확인</string>
    <string name="btn_cancel">취소</string>
    <string name="toast_keys_empty">문자를 1개 이상 입력하세요</string>
    <string name="label_chars">캐릭터</string>
    <string name="desc_chars">이미지(대기·타이핑 중·문자로 전환)와 내장 색상을 캐릭터별로 저장하고 전환할 수 있습니다. 이미지 탭에서의 편집은 \"사용 중\"인 캐릭터에 반영됩니다.</string>
    <string name="char_default_name">캐릭터 %1$d</string>
    <string name="label_in_use">(사용 중)</string>
    <string name="btn_use">사용</string>
    <string name="btn_rename">이름 변경</string>
    <string name="btn_add_char">+ 새 캐릭터(비어 있음)</string>
    <string name="btn_dup_char">+ 사용 중인 캐릭터 복제</string>
    <string name="dialog_char_name_title">캐릭터 이름</string>
    <string name="copy_suffix">%1$s 복사본</string>
    <string name="confirm_delete_char">「%1$s」을(를) 삭제할까요?</string>
