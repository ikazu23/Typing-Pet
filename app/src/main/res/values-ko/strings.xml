    <string name="label_shake">흔들림 강도</string>
    <string name="desc_shake">타이핑할 때 펫이 흔들리는 정도입니다. \"없음\"은 움직이지 않고 이미지만 바뀝니다.</string>
    <string name="shake_none">없음</string>
    <string name="shake_1">1단계</string>
    <string name="shake_2">2단계</string>
    <string name="shake_3">3단계</string>

    <string name="label_display">표시</string>
    <string name="switch_always_on_top_title">항상 위에 고정</string>
    <string name="switch_always_on_top_desc">ON이면 다른 앱을 열 때마다 펫이 자동으로 나타납니다. OFF면 ③ 버튼을 눌렀을 때만 표시됩니다.</string>
    <string name="switch_lock_title">위치 잠금(터치 통과)</string>
    <string name="switch_lock_desc">ON으로 하면 터치가 아래 앱으로 그대로 전달되고, 드래그로 이동할 수 없습니다.</string>
    <string name="btn_reset_pos">위치 초기화</string>

    <string name="label_builtin_color">내장 색상</string>
    <string name="desc_builtin_color">이미지 탭에서 이미지를 추가하지 않은 동안 여기서 선택한 색이 사용됩니다.</string>
    <string name="label_selected">선택됨</string>
    <string name="label_select">선택</string>

    <string name="btn_remove">삭제</string>


    <string name="label_icon_section">홈 화면 아이콘(선택)</string>
    <string name="desc_icon_section">Android 특성상 앱 자체의 아이콘은 설치 후에 바꿀 수 없습니다. 대신 선택한 이미지를 사용한 바로가기를 홈 화면에 추가할 수 있습니다. 추가한 뒤에는 그 아이콘으로 앱을 열어주세요.</string>
    <string name="btn_add_icon_shortcut">이미지를 선택해 홈 화면에 추가</string>
    <string name="toast_icon_not_supported">이 기기는 홈 화면 아이콘 추가를 지원하지 않습니다</string>

    <string name="label_idle">대기 이미지</string>
    <string name="desc_idle">입력하지 않을 때 표시됩니다. 여러 장이면 대기로 돌아올 때마다 랜덤으로 1장 선택됩니다. 비어 있으면 타이핑 세트의 첫 장(없으면 내장 색상)을 사용합니다.</string>
    <string name="label_typing">타이핑 중 이미지(세트)</string>
    <string name="desc_typing">입력 중에는 세트 안의 이미지가 번호 순서대로 바뀝니다. 세트가 여러 개면 입력을 시작할 때마다 랜덤으로 1세트가 선택됩니다.</string>
    <string name="set_label">세트 %1$d</string>
    <string name="btn_add_set">+ 세트 추가</string>
    <string name="btn_delete_set">세트 삭제</string>
    <string name="btn_add_image">+ 이미지 추가(여러 장 선택 가능)</string>
    <string name="empty_hint">아직 이미지가 없습니다</string>
    <string name="label_exclaim_pool">\"!\" 이미지(선택)</string>
    <string name="desc_exclaim_pool">!를 입력하는 순간 등록한 것 중 랜덤으로 1장 표시됩니다(내용은 저장·전송하지 않고 그 순간에 기호가 포함되어 있는지만 확인합니다).</string>
    <string name="label_question_pool">\"?\" 이미지(선택)</string>
    <string name="desc_question_pool">\?를 입력하는 순간 등록한 것 중 랜덤으로 1장 표시됩니다.</string>
</resources>
