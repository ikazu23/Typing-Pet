    <string name="btn_overlay">① 他のアプリの上に表示を許可</string>
    <string name="btn_accessibility">② アクセシビリティ設定を開く</string>
    <string name="btn_show_pet">③ ペットを表示する</string>

    <string name="tab_basic">基本設定</string>
