    <string name="label_shake">揺れの強さ</string>
    <string name="desc_shake">タイピング時にペットが揺れる度合いです。「なし」は動かず画像だけ切り替わります。</string>
    <string name="shake_none">なし</string>
    <string name="shake_1">1段階</string>
    <string name="shake_2">2段階</string>
    <string name="shake_3">3段階</string>

    <string name="label_display">表示</string>
    <string name="switch_always_on_top_title">常に最前面に固定</string>
    <string name="switch_always_on_top_desc">ONだと他のアプリを開いたときも自動でペットが現れます。OFFだと③ボタンを押した時だけ表示されます。</string>
    <string name="switch_lock_title">位置ロック(タップを素通し)</string>
    <string name="switch_lock_desc">ONにするとタップが下のアプリに通り抜け、ドラッグで動かせなくなります。</string>
    <string name="btn_reset_pos">位置を初期化</string>

    <string name="label_builtin_color">内蔵カラー</string>
    <string name="desc_builtin_color">イラストタブで画像を追加していない間は、ここで選んだ色が使われます。</string>
    <string name="label_selected">選択中</string>
    <string name="label_select">選ぶ</string>

    <string name="btn_remove">削除</string>


    <string name="label_icon_section">ホーム画面のアイコン(任意)</string>
    <string name="desc_icon_section">Androidの仕組み上、アプリ本体のアイコンは後から書き換えられません。代わりに、選んだ画像を使ったショートカットをホーム画面に追加できます。追加後はそちらのアイコンからアプリを開いてください。</string>
    <string name="btn_add_icon_shortcut">画像を選んでホーム画面に追加</string>
    <string name="toast_icon_not_supported">この端末はホーム画面へのアイコン追加に対応していません</string>

    <string name="label_idle">待機イラスト</string>
    <string name="btn_add_image">＋ 画像を追加(複数選択OK)</string>
    <string name="empty_hint">まだ画像がありません</string>
    <string name="desc_idle">入力していない時に表示されます。複数登録すると、待機に戻るたびにランダムで1枚選ばれます。未登録ならタイピング中の1番目の画像(なければ内蔵カラー)を使います。</string>
    <string name="label_steps">タイピング中イラスト(順番)</string>
    <string name="desc_steps">入力中は 1番目 → 2番目 → 3番目… の順に切り替わり、最後まで行くと1番目に戻ります。同じ番号に別パターンを追加すると、その番号のときにランダムで1枚選ばれます。</string>
    <string name="step_label">%1$d番目</string>
    <string name="btn_add_variant">＋ 別パターンを追加</string>
    <string name="btn_add_step">＋ 次の番号を追加</string>
    <string name="btn_delete_step">この番号を削除</string>
    <string name="label_triggers">文字で切り替え(任意)</string>
    <string name="desc_triggers">登録した文字を入力した瞬間、その画像からランダムで1枚表示されます。1つのイラストに複数の文字を割り当てられます(例:「あ」「う」でどよーん)。全角と半角は別の文字として扱います。入力内容は保存・送信せず、入力した位置の直前数文字に登録文字があるかをその場で照合するだけです。</string>
    <string name="trigger_keys_label">反応する文字: %1$s</string>
    <string name="key_format">「%1$s」</string>
    <string name="btn_edit_keys">文字を編集</string>
    <string name="btn_add_trigger">＋ 文字の反応を追加</string>
    <string name="dialog_keys_title">反応する文字</string>
    <string name="dialog_keys_hint">例: あ う (スペース区切りで複数OK)</string>
    <string name="btn_ok">OK</string>
    <string name="btn_cancel">キャンセル</string>
    <string name="toast_keys_empty">文字を1つ以上入力してください</string>
    <string name="label_chars">キャラ</string>
    <string name="desc_chars">イラスト(待機・タイピング中・文字で切り替え)と内蔵カラーを、キャラごとに保存して切り替えられます。イラストタブでの編集は「使用中」のキャラに反映されます。</string>
    <string name="char_default_name">キャラ %1$d</string>
    <string name="label_in_use">(使用中)</string>
    <string name="btn_use">使う</string>
    <string name="btn_rename">名前変更</string>
    <string name="btn_add_char">＋ 新しいキャラ(空っぽ)</string>
    <string name="btn_dup_char">＋ 使用中のキャラを複製</string>
    <string name="dialog_char_name_title">キャラの名前</string>
    <string name="copy_suffix">%1$sのコピー</string>
    <string name="confirm_delete_char">「%1$s」を削除しますか？</string>
    <string name="toast_last_char">最後の1体は削除できません</string>
    <string name="switch_shadow_title">足元の影を表示</string>
    <string name="switch_shadow_desc">ペットの足元に出る薄い影です。透過PNGのイラストで影が気になる場合はOFFにしてください。</string>
</resources>
